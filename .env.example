# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# JWT
JWT_SECRET_KEY=your-jwt-secret-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_VERIFY_TOKEN_EXPIRES=1800

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lexport
DB_USER=root
DB_PASSWORD=your-db-password

# Email (SMTP)
# 端口 587 → MAIL_USE_TLS=true  (STARTTLS)
# 端口 465 → MAIL_USE_SSL=true  (SSL，此时 MAIL_USE_TLS 设为 false)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=noreply@lexport.cn
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=LexPort <noreply@lexport.cn>

# Frontend URL (for verification link)
FRONTEND_URL=https://lexport.cn

# Upload
UPLOAD_PATH=./uploads
