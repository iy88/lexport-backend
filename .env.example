# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# JWT
JWT_SECRET_KEY=your-jwt-secret-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_VERIFY_TOKEN_EXPIRES=1800

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lexport
DB_USER=root
DB_PASSWORD=your-db-password

# Email (SMTP)
# 端口 587 → MAIL_USE_TLS=true  (STARTTLS)
# 端口 465 → MAIL_USE_SSL=true  (SSL，此时 MAIL_USE_TLS 设为 false)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=noreply@lexport.cn
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER="LexPort <noreply@lexport.cn>"

# Frontend URL (for verification link)
FRONTEND_URL=https://lexport.cn

# Upload
UPLOAD_PATH=./uploads

# Alibaba Cloud OSS
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
OSS_SIGN_URL_EXPIRES=7200

# Bailian (百炼) AI Platform
BAILIAN_API_KEY=your-bailian-api-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com
REPORT_GENERATOR_APPID=your-app-id
REPORT_AI_VERSION="LexPort AI v1.0"
REPORT_DATA_CUTOFF_DATE=2026-07-21

# Redis (Celery broker)
REDIS_URL=redis://127.0.0.1:6379/0
REPORT_POLL_INTERVAL_SECONDS=10
REPORT_TASK_TIMEOUT_SECONDS=7200

# Celery auto-start (开发环境设为 true 可随 Flask 一道启停 worker + beat)
CELERY_AUTO_START=false
CELERY_AUTO_STARTUP_GRACE_SECONDS=1.0
